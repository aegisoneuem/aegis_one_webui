{
  "name": "aegis-one-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @aegis/console dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . && prettier --check . && node scripts/check-colors.mjs",
    "format": "prettier --write .",
    "contract:lint": "redocly lint contracts/aegis-one.openapi.yaml",
    "contract:types": "openapi-typescript contracts/aegis-one.openapi.yaml -o apps/aegis-one/src/api/schema.d.ts",
    "mock": "pnpm --filter @aegis/mock-server start",
    "mock:seed": "pnpm --filter @aegis/mock-server seed",
    "test": "pnpm --filter @aegis/mock-core test && pnpm --filter @aegis/ui test",
    "e2e": "pnpm --filter @aegis/console e2e",
    "scan:semgrep": "semgrep --config p/react --config p/typescript --config p/owasp-top-ten --exclude node_modules --exclude dist --exclude storybook-static --exclude test-results .",
    "scan:zap:baseline": "zap.bat -cmd -autorun security/zap-baseline.yaml",
    "scan:zap:active": "zap.bat -cmd -autorun security/zap-active-api.yaml",
    "scan:token": "node security/get-token.mjs --export",
    "perf:lighthouse": "pnpm --filter @aegis/console lighthouse",
    "load:smoke": "k6 run -e PROFILE=smoke loadtest/scenarios.js",
    "load:load": "k6 run -e PROFILE=load loadtest/scenarios.js",
    "load:stress": "k6 run -e PROFILE=stress loadtest/scenarios.js",
    "load:soak": "k6 run -e PROFILE=soak loadtest/scenarios.js",
    "check:colors": "node scripts/check-colors.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@redocly/cli": "^2.72.1",
    "eslint": "^10.14.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-security": "^4.2.1",
    "globals": "^17.13.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
